MONGO_URI=mongodb://admin:password@mongodb:27017/chatapp?authSource=admin
MONGO_LOCAL_URI=mongodb://admin:password@localhost:27017

PORT=5000
NODE_ENV=production

JWT_SECRET=your_jwt_secret_here

# Local file storage (no longer using Cloudinary)
# Files are stored in backend/uploads/
SERVER_URL=http://your_vps_ip:5000
CLIENT_URL=http://your_vps_ip:8081

# Email Service
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Your Name <your_email@gmail.com>
